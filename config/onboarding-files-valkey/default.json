{
  "type": "valkey-onboarding-defaults",
  "aplication_name": "memorystore-valkey",
  "cluster_mode": "CLUSTER",
  "server_type": "STANDARD_SMALL",
  "shard_count": 1,
  "zone_distribution_mode": "MULTI_ZONE",
  "psc_connectivity_mode": "SHARED_VPC",
  "server_ca_mode": "GOOGLE_MANAGED_PER_INSTANCE_CA",
  "encryption_type": "GOOGLE_MANAGED",
  "persistence": {
    "mode": "RDB",
    "rdb_config": {
      "rdb_snapshot_period": "TWENTY_FOUR_HOURS"
    },
    "aof_config": {
      "append_fsync": "EVERY_SEC"
    }
  },
  "backup": {
    "enabled": true,
    "start_hour": 3,
    "backup_retention_days": 14
  },
  "version": "VALKEY_9_0",
  "maintenance_window": {
    "day_of_week": "SUNDAY",
    "start_hour": 4,
    "start_minute": 0
  },
  "config": {
    "maxmemory_policy": "volatile-lru",
    "notify_keyspace_events": "KEA",
    "maxmemory_clients": "10%",
    "slowlog_log_slower_than": 5000,
    "maxclients": 5000
  },
  "deletion_protection_enabled": false,
  "platformteam_emails": [
    "sifukun23@gmail.com"
  ],
  "dr_region_pairs": [
    ["us-central1", "us-east1"]
  ],
  "environments": {
    "dev": {
      "project_id": "valkeyhubhost-500604",
      "location": "us-central1",
      "networking": {
        "shared_vpc_network_project": "net-host-prod-502521",
        "shared_vpc_network_name": "shared-net"
      }
    },
    "qa": {
      "project_id": "your-qa-project-id",
      "location": "us-central1",
      "networking": {
        "shared_vpc_network_project": "net-host-prod-502521",
        "shared_vpc_network_name": "shared-net"
      }
    },
    "uat": {
      "project_id": "your-uat-project-id",
      "location": "us-central1",
      "networking": {
        "shared_vpc_network_project": "net-host-prod-502521",
        "shared_vpc_network_name": "shared-net"
      }
    },
    "prod": {
      "project_id": "your-prod-project-id",
      "location": "us-central1",
      "networking": {
        "shared_vpc_network_project": "net-host-prod-502521",
        "shared_vpc_network_name": "shared-net"
      }
    }
  }
}
