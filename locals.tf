locals {

  # var.env uses "prd" (matching typical TFC workspace naming, and
  # matching default.json's environments.prd key), but the valkey
  # module's environment variable validates against "PROD", not "PRD" —
  # upper(var.env) alone would fail for prd specifically.
  _env_label = {
    dev = "DEV"
    qa  = "QA"
    uat = "UAT"
    prd = "PROD"
  }

  # Human-readable environment TAG value — kept separate from var.env
  # itself. var.env stays the internal "prd" (matches the existing
  # TFC/TFE workspace naming and default.json's environments.prd key);
  # a label on the actual GCP resource should read "prod" the way a
  # human would write it, not the internal workspace abbreviation.
  #
  # NOTE: confirm with the wrapper-API team whether "prd" or "prod" is
  # the canonical env identifier going forward — default.json currently
  # ships environments.prd, so that's what this module keys off of; this
  # map only controls what shows up in the auto-populated `environment`
  # tag.
  _env_tag_label = {
    dev = "dev"
    qa  = "qa"
    uat = "uat"
    prd = "prod"
  }

  # --- Layer 1: global technical defaults + per-environment infra ---
  # default.json is generated by the onboarding wrapper API in a nested
  # shape — persistence{}, backup{}, maintenance_window{}, config{},
  # environments.<env>.networking{} — rather than flat keys matching the
  # module's variable names 1:1. Every local below that reads from
  # local._defaults_raw names the exact nested path it needs, field by
  # field, instead of relying on one generic top-level merge() the way
  # this file used to (see Layer 3's comment for why that distinction
  # matters).
  _defaults_raw = jsondecode(file("${path.module}/config/onboarding-files-valkey/default.json"))
  _env_infra    = local._defaults_raw.environments[var.env]

  # --- Layer 2: one onboarding request per file ---
  # Every *.json file in the folder except default.json is a self-service
  # request: { request_type, environment, instance: {...} }. Team PRs add
  # or edit exactly one file — no shared file to merge-conflict over.
  _all_instances = {
    for f in fileset("${path.module}/config/onboarding-files-valkey", "*.json") :
    f => jsondecode(file("${path.module}/config/onboarding-files-valkey/${f}"))
    if f != "default.json"
  }

  # Keyed by instance.name (the wrapper API's field for what the module
  # calls instance_id). Excludes anything not targeting the current
  # environment, and anything marked request_type = "delete". Every
  # request file's instance.name MUST be unique across ALL files for
  # this environment — two files sharing a name collide into a single
  # map entry and one request silently disappears. (This bit a real
  # onboarding request before: test-ha-cache.json had duplicated
  # test-dr-cache.json's "name": "test-dr-cache" instead of its own —
  # fixed in that file, but nothing here would have caught it
  # automatically. Consider a `check` block against
  # length(local._all_instances) == length(local._requested_instances)
  # if silent collisions are a recurring risk.)
  _requested_instances = {
    for f, payload in local._all_instances :
    payload.instance.name => payload
    if payload.environment == var.env && payload.request_type != "delete"
  }

  # RDB snapshot period as an ISO-8601-ish duration string, for timeadd().
  # Matches the module's own rdb_snapshot_period enum exactly.
  _rdb_period_to_duration = {
    ONE_HOUR          = "1h"
    SIX_HOURS         = "6h"
    TWELVE_HOURS      = "12h"
    TWENTY_FOUR_HOURS = "24h"
  }

  # --- Layer 3: defaults -> env infra -> instance overrides, flattened
  # into exactly the variable names
  # modules/terraform-google-h4ppy-memorystore-valkey (and its -alerts
  # sibling) expect.
  #
  # Every nested object here (persistence, backup, maintenance_window,
  # config) is merged FIELD BY FIELD, not with a single merge() of the
  # whole sub-object. merge() only merges its top-level arguments — if
  # an instance sets only `"persistence": {"mode": "AOF"}` (as
  # test-ha-cache.json does), a plain `merge(defaults.persistence,
  # instance.persistence)` at the top level would still work for
  # *persistence* itself, but the moment you nest one level deeper
  # (rdb_config / aof_config inside persistence) a naive merge silently
  # drops whichever nested defaults the instance's partial object didn't
  # restate. try(instance.X.Y, defaults.X.Y) per leaf field avoids that
  # entirely — an instance can override just persistence.mode and still
  # inherit persistence.aof_config.append_fsync from default.json.
  _valkey_raw = {
    for name, payload in local._requested_instances :
    name => {
      # --- Identity ---
      instance_id = payload.instance.name
      project_id  = local._env_infra.project_id
      location    = local._env_infra.location

      # --- Region / zone ---
      zone_distribution_mode = try(payload.instance.zone_distribution_mode, local._defaults_raw.zone_distribution_mode)
      zone                   = try(payload.instance.zone, null)
      secondary_zone         = try(payload.instance.secondary_zone, null)

      # --- Cluster topology & sizing ---
      cluster_mode  = try(payload.instance.cluster_mode, local._defaults_raw.cluster_mode)
      node_type     = try(payload.instance.server_type, local._defaults_raw.server_type)
      shard_count   = try(payload.instance.shard_count, local._defaults_raw.shard_count)
      replica_count = try(payload.instance.replica_count, 0)

      # --- PSC connectivity — host project/network are env-level infra,
      # never instance-settable (same rule as project_id/location: a
      # request can ask for SHARED_VPC, but never pick which shared VPC). ---
      psc_connectivity_mode   = try(payload.instance.psc_connectivity_mode, local._defaults_raw.psc_connectivity_mode)
      shared_vpc_host_project = try(local._env_infra.networking.shared_vpc_network_project, null)
      shared_vpc_network_name = try(local._env_infra.networking.shared_vpc_network_name, null)
      existing_scp_name       = try(payload.instance.existing_scp_name, null)

      # --- Auth / TLS / CA / CMEK ---
      authorization_mode      = try(payload.instance.authorization_mode, local._defaults_raw.authorization_mode)
      transit_encryption_mode = try(payload.instance.transit_encryption_mode, local._defaults_raw.transit_encryption_mode)
      server_ca_mode          = try(payload.instance.server_ca_mode, local._defaults_raw.server_ca_mode)
      server_ca_pool          = try(payload.instance.server_ca_pool, null)
      encryption_type         = try(payload.instance.encryption_type, local._defaults_raw.encryption_type)
      kms_key                 = try(payload.instance.kms_key, null)

      # --- Persistence (field-by-field — see note above) ---
      persistence_mode = try(payload.instance.persistence.mode, local._defaults_raw.persistence.mode)
      rdb_snapshot_period = try(
        payload.instance.persistence.rdb_config.rdb_snapshot_period,
        local._defaults_raw.persistence.rdb_config.rdb_snapshot_period
      )
      aof_config = {
        append_fsync = try(
          payload.instance.persistence.aof_config.append_fsync,
          local._defaults_raw.persistence.aof_config.append_fsync
        )
      }
      # Only an explicit instance-level override wins outright; the
      # computed default (Layer 4, from time_static) is used otherwise.
      _rdb_snapshot_start_time_override = try(payload.instance.rdb_snapshot_start_time, null)

      # --- Backups (field-by-field) ---
      automated_backup_enabled         = try(payload.instance.backup.enabled, local._defaults_raw.backup.enabled)
      automated_backup_start_time_hour = try(payload.instance.backup.start_hour, local._defaults_raw.backup.start_hour)
      automated_backup_retention_days  = try(payload.instance.backup.backup_retention_days, local._defaults_raw.backup.backup_retention_days)

      # --- Maintenance window (field-by-field). start_minute is accepted
      # from the wrapper payload but not used — the instance module's
      # maintenance window is hour-granularity only (minutes/seconds/
      # nanos are hardcoded to 0 in its main.tf). ---
      maintenance_day        = try(payload.instance.maintenance_window.day_of_week, local._defaults_raw.maintenance_window.day_of_week)
      maintenance_start_hour = try(payload.instance.maintenance_window.start_hour, local._defaults_raw.maintenance_window.start_hour)

      # --- Engine version & config parameters (field-by-field) ---
      engine_version          = try(payload.instance.version, local._defaults_raw.version)
      maxmemory_policy        = try(payload.instance.config.maxmemory_policy, local._defaults_raw.config.maxmemory_policy)
      notify_keyspace_events  = try(payload.instance.config.notify_keyspace_events, local._defaults_raw.config.notify_keyspace_events)
      maxmemory_clients       = try(payload.instance.config.maxmemory_clients, local._defaults_raw.config.maxmemory_clients)
      slowlog_log_slower_than = try(payload.instance.config.slowlog_log_slower_than, local._defaults_raw.config.slowlog_log_slower_than)
      maxclients              = try(payload.instance.config.maxclients, local._defaults_raw.config.maxclients)

      # --- Deletion protection ---
      deletion_protection_enabled = try(payload.instance.deletion_protection_enabled, local._defaults_raw.deletion_protection_enabled)

      # --- Alerting ---
      enable_alerting     = try(payload.instance.enable_alerting, true)
      appteam_emails      = try(payload.instance.appteam_emails, [])
      platformteam_emails = try(payload.instance.platformteam_emails, try(local._defaults_raw.platformteam_emails, []))

      # --- Raw tags + raw DR signal, carried through for Layer 4 to
      # derive labels / deployment_topology / secondary_location from.
      # Not module inputs themselves — main.tf never reads these two
      # underscore-prefixed keys directly. ---
      _raw_tags             = try(payload.instance.tags, {})
      _cross_region_replica = try(payload.instance.cross_region_replica, false)
    }
  }

  # Topology, computed once per instance so both Layer 4's
  # deployment_topology (module-facing, uppercase) and the auto-populated
  # `topology` tag (lowercase) derive from the exact same evaluation —
  # no duplicated ternary to let the two drift apart.
  _topology_by_name = {
    for name, cfg in local._valkey_raw :
    name => (
      try(cfg._cross_region_replica.enabled, cfg._cross_region_replica == true) ? "DR" :
      (cfg.replica_count > 0 ? "HA" : "STANDALONE")
    )
  }

  # --- Layer 4: derive deployment_topology, secondary_location,
  # rdb_snapshot_start_time, and labels/tags — every value here needs
  # something only computable AFTER Layer 3's per-field merge.
  #
  # `topology`, `environment`, and `managed_by` are ALWAYS derived here
  # and never taken from the request file, even if a request still sends
  # them (older payloads did, under tags.topology/tags.environment). That
  # was true duplication — the same fact (this instance's topology; which
  # environment it's in) declared once implicitly by replica_count/
  # cross_region_replica/request-environment, and a second time by hand
  # in tags, with nothing keeping the two in sync. Onboarding request
  # files no longer need to (or should) set tags.topology,
  # tags.environment, or tags.managed_by at all.
  valkey = {
    for name, cfg in local._valkey_raw :
    name => merge(cfg, {
      deployment_topology = local._topology_by_name[name]

      secondary_location = (
        local._topology_by_name[name] == "DR"
        ? local._env_infra.cross_region_replica.location
        : null
      )

      rdb_snapshot_start_time = (
        cfg.persistence_mode != "RDB" ? null :
        coalesce(
          cfg._rdb_snapshot_start_time_override,
          timeadd(
            time_static.rdb_anchor[name].rfc3339,
            local._rdb_period_to_duration[cfg.rdb_snapshot_period]
          )
        )
      )

      # application_id falls back to default.json's aplication_name
      # (that's the exact field name the wrapper API emits — a typo
      # upstream, not one to silently "fix" here since this module has
      # to consume exactly what the wrapper generates) when a request
      # doesn't supply its own. Any other requester-supplied tag (e.g.
      # lob) passes through unchanged; topology/environment/managed_by
      # are always overwritten by the derived values below, never
      # merged in from the request.
      labels = merge(
        { application_id = try(cfg._raw_tags.application_id, local._defaults_raw.aplication_name) },
        {
          for k, v in cfg._raw_tags : k => v
          if !contains(["application_id", "topology", "environment", "managed_by"], k)
        },
        {
          topology    = lower(local._topology_by_name[name])
          environment = local._env_tag_label[var.env]
          managed_by  = "terraform"
        }
      )
    })
  }
}
